rules_version = '2';

// Paste these into Firebase Console → Firestore Database → Rules → Publish.
// Each signed-in user can read/write ONLY their own document users/{uid}
// and everything inside it (history, retry list). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
